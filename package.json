{
  "name": "chocobo-racing",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SainyTK/chocobo-racing-threejs.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "studio": "vite --config studio/vite.config.ts",
    "character": "node scripts/characters/build.mjs",
    "build": "npm run check && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:studio": "playwright test --config tests/studio-playwright.config.ts",
    "test:production": "VITE_SIGNAL_URL=http://localhost:8796 npm run build && node --import tsx tests/production-smoke.mjs",
    "benchmark:multiplayer": "VITE_SIGNAL_URL=http://localhost:8796 npm run build && node --import tsx tests/multiplayer-benchmark.ts",
    "check": "tsc --noEmit && tsc -p signaling",
    "deploy:signal": "wrangler deploy --config signaling/wrangler.jsonc"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.1"
  }
}
